# Copy this file to .env and fill in real values. Do not commit .env.
# Django secret key - generate a random 50-char string
SECRET_KEY=replace-with-a-long-random-secret

# Spoonacular API key (recipes) - https://spoonacular.com/food-api
SPOONACULAR_API_KEY=your-spoonacular-api-key

# Groq API key (kitchen assistant chatbot) - https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# Set to True only for local development
DEBUG=False
